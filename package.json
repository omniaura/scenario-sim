{
  "name": "@omniaura/scenario-sim",
  "version": "0.3.0",
  "description": "Deterministic scenario simulator for frontend QA: stateful CRUD routes, seeded RNG, virtual clock, response sequences, faults and overrides, SSE and WebSocket routes with scheduled events and resume, per-run isolation, inspectable event log. Runtime-neutral core (Web Request/Response) with Bun/Node server, Vite middleware and in-browser adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "scenario-sim": "dist/cli.js"
  },
  "exports": {
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./pulse": {
      "types": "./dist/pulse.d.ts",
      "import": "./dist/pulse.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun --conditions=browser --conditions=development test tests && bun --conditions=browser --conditions=development test e2e",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mock",
    "simulator",
    "scenario",
    "msw",
    "sse",
    "websocket",
    "deterministic",
    "seeded",
    "qa",
    "vite-plugin",
    "solid",
    "tanstack-query"
  ],
  "license": "MIT",
  "author": "omniaura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniaura/scenario-sim.git"
  },
  "homepage": "https://github.com/omniaura/scenario-sim#readme",
  "bugs": {
    "url": "https://github.com/omniaura/scenario-sim/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^22",
    "@types/ws": "^8.5.12",
    "happy-dom": "^20.14.5",
    "semantic-release": "25",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.0.0"
  }
}
